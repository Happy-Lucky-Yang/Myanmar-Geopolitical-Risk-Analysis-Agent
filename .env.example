# ========================================
# 缅甸地缘风险智能分析原型系统 - 环境变量模板
# 使用方法：复制本文件为 .env，填入你自己的真实密钥
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)
# .env 已被 .gitignore 拦截，不会被提交——真实密钥只写在 .env 里！
# ========================================

# ---------- 大模型 API（必填，否则 LLM 分析走降级路径） ----------
# 以下环境变量会在运行时自动覆盖 config.yaml 中的占位符（见 utils/config.py）
# 推荐：智谱开放平台 bigmodel.cn 注册，GLM-4-Flash 免费
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=把你的Key粘贴到这里
LLM_MODEL_NAME=glm-4-flash

# ---------- Neo4j 图数据库（可选，不装也能跑） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ---------- 高级选项（可选） ----------
# 若 .env 存放在项目外的私密目录，可设置系统环境变量 ENV_FILE 指向它
# ENV_FILE=C:\path\to\private\.env

# 数据存储根目录：留空=项目内 ./data；填写绝对路径可将爬取数据外置到项目外
# （避免第三方新闻内容、日志等随仓库分发）。系统会自动创建 raw/processed/external 子目录
# DATA_ROOT=C:\path\to\private\运行数据
