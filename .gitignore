# ========================================
# 缅甸地缘风险智能分析原型系统 - Git 忽略规则
# ========================================

# ---------- 敏感信息（绝不提交） ----------
.env
*.docx                      # 申报书/内部文档（.env.example 模板保留提交）

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.so
*.egg-info/
dist/
build/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- 运行时数据（爬取内容含第三方版权，不再分发） ----------
data/raw/*.json
data/raw/*.jsonl
data/raw/*.csv
data/raw/*.txt
data/processed/
data/external/
# 例外：自建历史事件数据集属团队成果，允许开源
!data/raw/historical_events.json

# ---------- 日志 ----------
logs/*
!logs/.gitkeep

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 前端 / 打包 ----------
node_modules/

# ---------- 临时文件 ----------
*.tmp
*_temp.*
docs/_proposal_temp.txt
# 临时验证脚本
*_tmp_*.py
# Python 3.12 安装器/隔离环境（体积大，不入 git）
py312_installer.exe
py312/
venv312/
# 浏览器验证截图残留
dashboard_source_health_card.png
# GIS 原始数据（体积大/二进制，不入 git；行政边界用 data/static/gadm/ 的 GeoJSON）
*.shp
*.gdb/
*.gpkg
mmr_adm*
*.emf
